<resources>
    <!--
      页面背景：刻意不随主题配色变化，五套配色共用这一个中性色（夜间见 values-night）。
      主题颜色只作用于按钮、旋钮、开关等控件，页面和卡片保持中性——和孪生项目
      ScreenshotBye 的 page_background / card_surface 取值一致。
    -->
    <color name="page_background">#F6F5F4</color>
    <!-- 卡片背景：亮色下比页面深一档（夜间反而更亮一档，层次都是"页面 < 卡片"） -->
    <color name="card_surface">#EEEDEB</color>
</resources>
