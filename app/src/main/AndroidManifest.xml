<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.DELETE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 设置页旋钮切档时的触感反馈。普通权限，安装时自动授予，无需用户手动开启 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".PhotosManagerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PHOTOSMANAGER">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PHOTOSMANAGER"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="设置"
            android:theme="@style/Theme.PHOTOSMANAGER" />

        <!-- 相册选择收在设置页的次级页面里，免得几十本相册把开关和旋钮挤出首屏 -->
        <activity
            android:name=".ui.settings.AlbumPickerActivity"
            android:exported="false"
            android:label="相册设置"
            android:theme="@style/Theme.PHOTOSMANAGER" />
        
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:label="引导"
            android:theme="@style/Theme.PHOTOSMANAGER" />
        
        <!-- 确认删除页跑在独立的任务栈里（taskAffinity 与主应用不同，且不出现在最近任务里），
             这样它 finish 之后系统会回到用户亮屏前正在看的应用，而不是应用主页或桌面。
             launchMode 用 standard：每次从悬浮窗进来都是一个全新实例、全新的待删列表。 -->
        <activity
            android:name=".ui.confirm.ConfirmDeleteActivity"
            android:exported="false"
            android:label="确认删除"
            android:theme="@style/Theme.PHOTOSMANAGER"
            android:taskAffinity="com.example.photosmanager.confirm"
            android:excludeFromRecents="true"
            android:launchMode="standard" />
        
        <!-- 屏幕监听服务 -->
        <service
            android:name=".service.ScreenMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="照片管理-屏幕监听" />
        </service>
        
        <!-- 悬浮窗服务 -->
        <service
            android:name=".service.FloatingWindowService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="照片管理-悬浮窗" />
        </service>
        
        <!-- 后台常驻服务 -->
        <service
            android:name=".service.BackgroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="照片管理-后台服务" />
        </service>
    </application>

</manifest>